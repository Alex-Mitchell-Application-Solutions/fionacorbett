# Copy to .env and fill in. The real file is never committed.
#
# Named env.example rather than .env.example, matching luxury-gardens. The
# dotted name is the wider convention and gets dotenv syntax highlighting, but
# consistency with the sibling repo is worth more than the highlighting, and
# agent file-write rules here block the dotted path outright.
#
# Everything here is read server side. NEXT_PUBLIC_* values are the exception:
# they are inlined into the client bundle at build time, which is why they also
# have to be build arguments in the Dockerfile. A runtime-only value is baked in
# as undefined, and the symptom is a form that silently cannot submit.

# ---------------------------------------------------------------------------
# Required everywhere
# ---------------------------------------------------------------------------

# Postgres. `pnpm run db:up` starts the local one this matches.
#
# Port 5433, not 5432, and deliberately. If you also run Postgres.app or a
# Homebrew Postgres, it binds loopback explicitly while Docker binds the
# wildcard — so a specific binding wins and `localhost:5432` quietly reaches the
# native server instead of this project's container. The symptom is
# `role "fionacorbett" does not exist`, which looks like a broken container and
# is not. See compose.yaml.
DATABASE_URL=postgres://fionacorbett:fionacorbett@localhost:5433/fionacorbett

# Signs Payload's sessions and the memory form's dwell token. Any long random
# string; generate with `openssl rand -hex 32`. Changing it logs everyone out
# and invalidates every dwell token currently sitting on a screen.
PAYLOAD_SECRET=replace-me-with-32-random-bytes

# The site's own origin, no trailing slash. Resolves relative URLs in the head,
# so a link shared in WhatsApp carries a preview image that actually loads.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Which instance this is: development, preview or production.
# Anything unset or misspelled is treated as development, the least privileged
# reading. Only `production` makes the human check mandatory.
SITE_ENV=development

# ---------------------------------------------------------------------------
# Object storage. Unset locally: uploads go to the container disk instead.
# Set as a group or not at all — a half-configured bucket throws at boot rather
# than silently writing somewhere that does not survive a redeploy.
# ---------------------------------------------------------------------------

# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Older Railway buckets need path-style URLs. Their Credentials tab says which.
# S3_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------------------
# Cloudflare Turnstile, the human check on the memory form.
#
# SET BOTH OR NEITHER. Half-configured is refused with a 500 rather than
# accepted, because the failure mode is otherwise invisible: the widget only
# renders when the SITE key is present, so a secret on its own means no token is
# ever produced, every genuine submission looks like a bot, and the sender is
# told it arrived. See src/lib/memories/turnstile.ts.
#
# The site key MUST carry the NEXT_PUBLIC_ prefix in full. Next exposes only
# that prefix to the browser, so PUBLIC_TURNSTILE_SITE_KEY reads as undefined
# with no warning anywhere.
#
# Cloudflare's test keys, which always pass, are:
#   site   1x00000000000000000000AA
#   secret 1x0000000000000000000000000000000AA
#
# Optional in development and preview. Required in production, where a missing
# secret is refused rather than skipped.
# ---------------------------------------------------------------------------

# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Seeding a fresh database. Read only by `pnpm run seed`, which is a local
# bootstrap and never part of a deploy. Leave these out of the deployed service.
# ---------------------------------------------------------------------------

# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
